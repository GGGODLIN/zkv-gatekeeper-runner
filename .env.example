# Required: Agent HMAC secret from Agent Games dashboard ("Rotate Secret")
AGENT_GAMES_HMAC_SECRET=

# Optional: Previous HMAC secret accepted during rotation grace window
AGENT_GAMES_HMAC_SECRET_PREVIOUS=

# Optional: auto | utf8 | hex (default: auto for inbound, utf8 for outbound)
AGENT_GAMES_HMAC_SECRET_FORMAT=auto

# Server network binding and SQLite storage
HOST=127.0.0.1
PORT=3411
SQLITE_DB_PATH=./gatekeeper.db

# Reason code profile: event_page (default) | canonical_rules
REASON_CODE_PROFILE=event_page

# Soft deadline before 60s platform cutoff (ms)
SOFT_DEADLINE_MS=45000

# Optional: Kurier Mainnet REST API key (when unset, returns verified local Groth16 proof)
KURIER_API_KEY=
KURIER_API_URL=https://api.kurier.xyz/api/v1
KURIER_TIMEOUT_MS=10000
